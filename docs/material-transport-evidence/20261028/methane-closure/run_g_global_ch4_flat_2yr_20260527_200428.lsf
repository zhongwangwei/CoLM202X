#!/bin/bash
#BSUB -J ch4_flat_2yr
#BSUB -q normal
#BSUB -o /share/home/dq013/zhwei/colm/cases/globe/g_global_ch4_flat_2yr_20260527_200428/logs/lsf.%J.out
#BSUB -e /share/home/dq013/zhwei/colm/cases/globe/g_global_ch4_flat_2yr_20260527_200428/logs/lsf.%J.err
#BSUB -n 720
#BSUB -R "rusage[mem=150G]"
#BSUB -R "span[ptile=48]"
set -euo pipefail
MPI=/share/home/dq013/software/mvapich2-2.3.7-1-intel
NET=/share/home/dq013/software/netcdf_parallel_N
HDF=/share/home/dq013/software/hdf5-1.14.3-Intel_MPI_N
export PATH="$MPI/bin:$PATH"
export LD_LIBRARY_PATH="$NET/lib:$HDF/lib:/share/home/dq013/software/zlib-1.2.11/lib:/share/home/dq013/software/szip-2.1.1/lib:$MPI/lib:${LD_LIBRARY_PATH:-}"
export OMP_NUM_THREADS=1
cd /share/home/dq013/zhwei/colm/script/CoLM202X/run
echo "job start: $(date)"
echo "host: $(hostname)"
echo "nml: /share/home/dq013/zhwei/colm/cases/globe/g_global_ch4_flat_2yr_20260527_200428/config/g_global_ch4_flat_2yr_20260527_200428.nml"
echo "case: /share/home/dq013/zhwei/colm/cases/globe/g_global_ch4_flat_2yr_20260527_200428"
echo "mpirun: $(command -v mpirun)"
ldd ./colm.x | egrep 'libnetcdf|libnetcdff|libmpi|libmpifort|libblas|liblapack|not found' || true
echo "=== mkinidata start: $(date) ==="
mpirun -np 48 ./mkinidata.x /share/home/dq013/zhwei/colm/cases/globe/g_global_ch4_flat_2yr_20260527_200428/config/g_global_ch4_flat_2yr_20260527_200428.nml > /share/home/dq013/zhwei/colm/cases/globe/g_global_ch4_flat_2yr_20260527_200428/mkinidata_global_current.log 2>&1
echo "=== mkinidata done: $(date) ==="
echo "=== colm start: $(date) ==="
mpirun -np 720 ./colm.x /share/home/dq013/zhwei/colm/cases/globe/g_global_ch4_flat_2yr_20260527_200428/config/g_global_ch4_flat_2yr_20260527_200428.nml > /share/home/dq013/zhwei/colm/cases/globe/g_global_ch4_flat_2yr_20260527_200428/colm_global_current.log 2>&1
echo "=== colm done: $(date) ==="
grep -E 'Master is|methane_registry_init|CoLM Execution Completed|Time elapsed|ERROR|Error|FATAL|MPI_Abort' /share/home/dq013/zhwei/colm/cases/globe/g_global_ch4_flat_2yr_20260527_200428/colm_global_current.log | tail -120 || true
echo "job end: $(date)"
