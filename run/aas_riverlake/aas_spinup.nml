&nl_colm

! ==============================================================================
!  AAS 河湖流实验 —— 阶段 0：共享陆面 spinup (1996-1999)
! ------------------------------------------------------------------------------
!  为什么 8 组实验可以共享这一次 spinup：
!    汇流对陆面是【单向】的。全仓检索 push_ucat2grid 只出现在
!    MOD_Grid_RiverLakeHist.F90（历史输出），汇流状态从不回写陆面 patch。
!    因此 bif/levee/dam 三个开关的取值不影响陆面解，用 CTL 配置跑出的
!    陆面 restart 对 8 组完全等价。这一步省下 4x7 = 28 个模式年。
!
!  跑法：
!    mpirun -np 128 ./mksrfdata.x  aas_spinup.nml   # 地表数据，8 组共享，只做一次
!    mpirun -np 512 ./mkinidata.x  aas_spinup.nml   # 初始场
!    mpirun -np 512 ./colm.x       aas_spinup.nml   # 1996-1999 积分
!    ./distribute_restart.sh                        # 把 19991231 的 restart 分发给 8 组
!
!  编译前提（include/define.h）：
!    #define GRIDBASED / LULC_IGBP_PFT / USEMPI / GridRiverLakeFlow
!    #define vanGenuchten_Mualem_SOIL_MODEL
!    #undef  BGC / CROP / TRACER / CaMa_Flood / URBAN_MODEL / LULCC
!    改完 define.h 必须 make clean 后完整重编（Makefile 不追踪 define.h 依赖）
! ==============================================================================

   DEF_CASE_NAME = 'SPINUP'

   ! ----- 模拟域：全球 -----
   DEF_domain%edges =  -90.0
   DEF_domain%edgen =   90.0
   DEF_domain%edgew = -180.0
   DEF_domain%edgee =  180.0

   ! ----- 时间：1996-1999 共 4 年，仅为得到平衡的陆面状态 -----
   ! spinup_repeat = 0 表示不做循环 spinup，直接顺序积分 1996->1999。
   DEF_simulation_time%greenwich     = .TRUE.
   DEF_simulation_time%start_year    = 1996
   DEF_simulation_time%start_month   = 1
   DEF_simulation_time%start_day     = 1
   DEF_simulation_time%start_sec     = 0
   DEF_simulation_time%end_year      = 1999
   DEF_simulation_time%end_month     = 12
   DEF_simulation_time%end_day       = 31
   DEF_simulation_time%end_sec       = 86400
   DEF_simulation_time%spinup_repeat = 0
   DEF_simulation_time%timestep      = 1800.

   ! ----- 路径（请按自己的拷贝目录修改）-----
   DEF_dir_rawdata = '/share/home/dq013/zhwei/colm/data/CoLMrawdata/'
   DEF_dir_runtime = '/share/home/dq013/zhwei/colm/data/CoLMruntime/'
   DEF_dir_output  = '/share/home/dq013/zhwei/colm/cases/aas_riverlake/output/SPINUP/'
   DEF_dir_restart = '/share/home/dq013/zhwei/colm/cases/aas_riverlake/restart/SPINUP/'

   ! ----- 陆面分辨率 0.5 度 -----
   DEF_GRIDBASED_lon_res = 0.5
   DEF_GRIDBASED_lat_res = 0.5

   ! ----- 土壤初始场 -----
   ! 4 年 spinup 对深层地下水不足，用气候态土壤状态起步以缓解。
   ! 因 8 组共享同一份陆面状态，残余不平衡对【组间差异】无影响。
   DEF_USE_SoilInit  = .true.
   DEF_file_SoilInit = '/share/home/dq013/zhwei/colm/data/CoLMruntime/soilstate.nc'

   ! ----- 植被：月尺度气候态 LAI，年际不变 -----
   ! CHANGE_YEARLY = .false. 保证 8 组之间植被强迫完全一致，
   ! 也避免把 LAI 年际变率混进 bif/levee/dam 的信号里。
   DEF_LAI_MONTHLY       = .true.
   DEF_LAI_CHANGE_YEARLY = .false.
   DEF_USE_LAIFEEDBACK   = .false.

   ! ----- 关闭与本文无关的过程（保持 8 组配置一致、减少混淆变量）-----
   DEF_USE_PLANTHYDRAULICS = .false.
   DEF_USE_OZONESTRESS     = .false.
   DEF_USE_OZONEDATA       = .false.
   DEF_USE_IRRIGATION      = .false.
   DEF_USE_SNICAR          = .false.
   DEF_VEG_SNOW            = .false.
   DEF_Interception_scheme = 1          ! CoLM 默认冠层截留

   ! ----- 产流与土壤水 -----
   DEF_USE_VariablySaturatedFlow = .true.
   DEF_Runoff_SCHEME             = 3     ! Simple VIC，与汇流方案配套
   DEF_USE_Dynamic_Lake          = .true.

   ! ==========================================================================
   !  汇流配置：0.25 度 (15 min) unit catchment
   ! --------------------------------------------------------------------------
   !  spinup 阶段三个开关【全关】，等价于 E0_CTL。
   !  陆面解与这三个开关无关，所以用哪组配置跑 spinup 都得到相同的陆面 restart。
   ! ==========================================================================
   DEF_UnitCatchment_file       = '/share/home/dq013/zhwei/colm/data/CoLMruntime/unitcatchment/grid_routing_data_15min.nc'
   DEF_GRIDBASED_ROUTING_MAX_DT = 3600.  ! 产流累积上限；汇流内部按 CFL 自适应切子步
   DEF_USE_EstimatedRiverDepth  = .true.

   DEF_Reservoir_Method         = 0      ! 0 = 完全不调用 reservoir_init (CoLM.F90:296)
   DEF_USE_LEVEE                = .false.
   DEF_USE_BIFURCATION          = .false.

   ! ----- 大气强迫：JRA3Q -----
   DEF_forcing_namelist = '/share/home/dq013/zhwei/colm/script/CoLM202X/run/forcing/JRA3Q.nml'

   ! ----- 输出：spinup 阶段不需要历史文件，只要末期 restart -----
   ! HIST_FREQ = 'YEARLY' 是最省的合法设置；真正需要的是 WRST_FREQ 写出 restart。
   DEF_HIST_lon_res  = 0.5
   DEF_HIST_lat_res  = 0.5
   DEF_HIST_FREQ     = 'YEARLY'
   DEF_HIST_groupby  = 'YEAR'
   DEF_WRST_FREQ     = 'YEARLY'          ! 每年末写 restart，1999-12-31 那份是我们要的
   DEF_HIST_mode     = 'one'
   DEF_HIST_CompressLevel = 4
   DEF_REST_CompressLevel = 1
   DEF_HIST_WriteBack     = .false.

   ! 注意：不要写 DEF_hist_vars_out_default —— 该变量在 share/MOD_Namelist.F90 中
   ! 【从未定义】，尽管 run/Amazon.nml:52 等既有 nml 里出现过它。
   ! spinup 阶段只需要末期 restart，用汇流清单把输出压到最小（9 个变量）。
   DEF_HIST_vars_namelist = '/share/home/dq013/zhwei/colm/script/CoLM202X/run/aas_riverlake/hist_vars_routing.nml'

/
