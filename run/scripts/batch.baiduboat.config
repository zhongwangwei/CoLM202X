set -euo pipefail
D89=/share/home/dq089/soft
export PATH=$D89/mpich-4.2.3-gnu/bin:$PATH
export LD_LIBRARY_PATH=$D89/mpich-4.2.3-gnu/lib:$D89/hdf5-1.14.5-gnu/lib:$D89/netcdf-c-4.9.2-gnu/lib:$D89/netcdf-fortran-4.6.1-gnu/lib:/usr/lib64:${LD_LIBRARY_PATH:-}
export OMP_NUM_THREADS=1
export HDF5_USE_FILE_LOCKING=FALSE
ulimit -s unlimited
